shinyApp(ui = ui, server = server)
# ------------------------------
# استيراد المكتبات الأساسية فقط
# ------------------------------
library(shiny)
library(readxl)
library(dplyr)
library(lubridate)
library(plotly)
library(DT)
# ------------------------------
# CSS بسيط
# ------------------------------
custom_css <- "
body {
background: #0b1120 !important;
color: #f0f4f8 !important;
font-family: 'Segoe UI', sans-serif !important;
}
.well {
background: #151e32 !important;
border: 1px solid #2a3a52 !important;
}
.form-control {
background: #1a2332 !important;
border: 1px solid #2a3a52 !important;
color: #f0f4f8 !important;
}
label {
color: #f0f4f8 !important;
}
.btn-primary {
background: #22d3ee !important;
border: none !important;
color: #0b1120 !important;
}
.btn-success {
background: #34d399 !important;
border: none !important;
color: #0b1120 !important;
}
.nav-tabs > li > a {
color: #8b9db8 !important;
}
.nav-tabs > li.active > a {
color: #22d3ee !important;
background: #1a2332 !important;
}
.panel-box {
background: #1a2332 !important;
border: 1px solid #2a3a52 !important;
border-radius: 10px !important;
padding: 10px !important;
}
.stat-card {
background: #1a2332 !important;
border: 1px solid #2a3a52 !important;
border-radius: 10px !important;
padding: 15px !important;
text-align: center !important;
}
.stat-value {
font-size: 22px !important;
font-weight: 800 !important;
color: #f0f4f8 !important;
}
.stat-label {
font-size: 11px !important;
color: #8b9db8 !important;
}
hr {
border-color: #2a3a52 !important;
}
"
# ------------------------------
# واجهة المستخدم
# ------------------------------
ui <- fluidPage(
tags$head(
tags$style(HTML(custom_css))
),
# رأس التطبيق
div(style = "
background: #151e32;
border: 1px solid #2a3a52;
border-radius: 10px;
padding: 15px 20px;
margin-bottom: 20px;
text-align: center;
",
h1(style = "color: #22d3ee; margin: 0; font-size: 24px;", "📊 Dashboard Achats"),
h4(style = "color: #8b9db8; margin: 5px 0 0 0; font-size: 14px;", "VIEUX KOUBA & DJENANE SFARI")
),
sidebarLayout(
sidebarPanel(
width = 3,
style = "background: #151e32; border-radius: 10px; padding: 15px;",
fileInput("file",
"📂 Charger Excel",
accept = c(".xlsx", ".xls")),
hr(),
h5(style = "color: #8b9db8;", "🏗️ Projet"),
uiOutput("project_filter"),
h5(style = "color: #8b9db8;", "🏢 Fournisseur"),
uiOutput("supplier_filter"),
hr(),
actionButton("reset", "↺ Réinitialiser",
style = "width: 100%; background: transparent; color: #8b9db8; border: 1px solid #2a3a52; padding: 8px; border-radius: 8px;")
),
mainPanel(
width = 9,
# رسالة الخطأ
uiOutput("error_msg"),
# بطاقات KPIs
fluidRow(
column(3, uiOutput("kpi_ht")),
column(3, uiOutput("kpi_ttc")),
column(3, uiOutput("kpi_suppliers")),
column(3, uiOutput("kpi_rows"))
),
hr(),
tabsetPanel(
tabPanel("📈 Graphiques",
br(),
fluidRow(
column(6, div(class = "panel-box", plotlyOutput("plot1", height = "300px"))),
column(6, div(class = "panel-box", plotlyOutput("plot2", height = "300px")))
),
fluidRow(
column(12, div(class = "panel-box", plotlyOutput("plot3", height = "280px")))
)
),
tabPanel("📋 Données",
br(),
div(class = "panel-box", DTOutput("table1"))
)
)
)
)
)
# ------------------------------
# الخادم
# ------------------------------
server <- function(input, output, session) {
# -------- تحميل البيانات --------
data_loaded <- reactive({
req(input$file)
tryCatch({
df <- read_excel(input$file$datapath, sheet = "GLOBAL")
# توحيد أسماء الأعمدة
names(df) <- toupper(names(df))
names(df) <- gsub(" ", "_", names(df))
# التأكد من وجود الأعمدة المطلوبة
required <- c("DATE", "ARTICLE", "MONTANT_TOTAL_HT", "TOTAL_TTC", "FOURNISSEUR", "PROJET")
missing <- required[!required %in% names(df)]
if (length(missing) > 0) {
showNotification(paste("Colonnes manquantes:", paste(missing, collapse=", ")), type="error", duration=10)
return(NULL)
}
# تحويل التاريخ
df$DATE <- as.Date(df$DATE)
df$MONTANT_TOTAL_HT <- as.numeric(df$MONTANT_TOTAL_HT)
df$TOTAL_TTC <- as.numeric(df$TOTAL_TTC)
# إزالة الصفوف الفارغة
df <- df %>% filter(!is.na(DATE), !is.na(MONTANT_TOTAL_HT))
# إضافة عمود الشهر
df$MOIS <- format(df$DATE, "%Y-%m")
df
}, error = function(e) {
showNotification(paste("Erreur:", e$message), type="error", duration=10)
NULL
})
})
# -------- عرض الخطأ --------
output$error_msg <- renderUI({
if (is.null(data_loaded()) && !is.null(input$file)) {
div(style = "background-color: #3a1520; color: #fca5a5; padding: 15px; border-radius: 8px; margin-bottom: 15px; border: 1px solid #7f1d3d;",
"⚠️ Erreur de chargement. Vérifiez le format du fichier.")
}
})
# -------- الفلاتر --------
output$project_filter <- renderUI({
df <- data_loaded()
req(df)
projects <- sort(unique(df$PROJET))
selectInput("project", NULL, choices = c("Tous" = "All", projects), selected = "All")
})
output$supplier_filter <- renderUI({
df <- data_loaded()
req(df)
suppliers <- sort(unique(df$FOURNISSEUR))
selectInput("supplier", NULL, choices = c("Tous" = "All", suppliers), selected = "All")
})
# -------- البيانات المفلترة --------
filtered <- reactive({
df <- data_loaded()
req(df)
if (!is.null(input$project) && input$project != "All") {
df <- df %>% filter(PROJET == input$project)
}
if (!is.null(input$supplier) && input$supplier != "All") {
df <- df %>% filter(FOURNISSEUR == input$supplier)
}
df
})
# -------- إعادة تعيين --------
observeEvent(input$reset, {
updateSelectInput(session, "project", selected = "All")
updateSelectInput(session, "supplier", selected = "All")
showNotification("✅ Réinitialisé", type = "message", duration = 2)
})
# -------- بطاقات KPIs --------
kpi_card <- function(value, label, color = "#22d3ee") {
div(class = "stat-card",
div(class = "stat-value", value),
div(class = "stat-label", label)
)
}
output$kpi_ht <- renderUI({
df <- filtered()
req(df)
total <- sum(df$MONTANT_TOTAL_HT, na.rm = TRUE)
kpi_card(format(round(total), big.mark = ","), "Total HT", "#22d3ee")
})
output$kpi_ttc <- renderUI({
df <- filtered()
req(df)
total <- sum(df$TOTAL_TTC, na.rm = TRUE)
kpi_card(format(round(total), big.mark = ","), "Total TTC", "#34d399")
})
output$kpi_suppliers <- renderUI({
df <- filtered()
req(df)
kpi_card(length(unique(df$FOURNISSEUR)), "Fournisseurs", "#fbbf24")
})
output$kpi_rows <- renderUI({
df <- filtered()
req(df)
kpi_card(nrow(df), "Lignes", "#a78bfa")
})
# -------- الرسوم البيانية --------
output$plot1 <- renderPlotly({
df <- filtered()
req(df)
validate(need(nrow(df) > 0, "Pas de données"))
plot_data <- df %>%
group_by(PROJET) %>%
summarise(TOTAL = sum(TOTAL_TTC, na.rm = TRUE))
plot_ly(plot_data,
labels = ~PROJET,
values = ~TOTAL,
type = "pie",
hole = 0.5,
marker = list(colors = c("#22d3ee", "#a78bfa", "#34d399"))) %>%
layout(paper_bgcolor = "#1a2332",
plot_bgcolor = "#1a2332",
font = list(color = "#f0f4f8"))
})
output$plot2 <- renderPlotly({
df <- filtered()
req(df)
validate(need(nrow(df) > 0, "Pas de données"))
plot_data <- df %>%
group_by(FOURNISSEUR) %>%
summarise(TOTAL = sum(TOTAL_TTC, na.rm = TRUE)) %>%
arrange(desc(TOTAL)) %>%
head(10)
plot_ly(plot_data,
x = ~TOTAL,
y = ~reorder(FOURNISSEUR, TOTAL),
type = "bar",
orientation = "h",
marker = list(color = "#22d3ee")) %>%
layout(paper_bgcolor = "#1a2332",
plot_bgcolor = "#1a2332",
font = list(color = "#f0f4f8"),
xaxis = list(gridcolor = "#2a3a52"),
yaxis = list(gridcolor = "#2a3a52"))
})
output$plot3 <- renderPlotly({
df <- filtered()
req(df)
validate(need(nrow(df) > 0, "Pas de données"))
plot_data <- df %>%
group_by(MOIS) %>%
summarise(TOTAL = sum(TOTAL_TTC, na.rm = TRUE)) %>%
arrange(MOIS)
plot_ly(plot_data,
x = ~MOIS,
y = ~TOTAL,
type = "scatter",
mode = "lines+markers",
line = list(color = "#22d3ee", width = 3),
marker = list(color = "#a78bfa", size = 8)) %>%
layout(paper_bgcolor = "#1a2332",
plot_bgcolor = "#1a2332",
font = list(color = "#f0f4f8"),
xaxis = list(gridcolor = "#2a3a52"),
yaxis = list(gridcolor = "#2a3a52"))
})
# -------- الجدول --------
output$table1 <- renderDT({
df <- filtered()
req(df)
df_display <- df %>%
select(DATE, ARTICLE, MONTANT_TOTAL_HT, TOTAL_TTC, FOURNISSEUR, PROJET) %>%
mutate(DATE = format(DATE, "%Y-%m-%d"),
MONTANT_TOTAL_HT = round(MONTANT_TOTAL_HT, 2),
TOTAL_TTC = round(TOTAL_TTC, 2))
datatable(
df_display,
options = list(
paging = FALSE,
scrollY = "400px",
scrollX = TRUE,
dom = 'Bfrti',
buttons = c('copy', 'csv', 'excel')
),
extensions = c('Buttons', 'Scroller'),
class = 'display compact',
rownames = FALSE
)
})
}
