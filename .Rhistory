}
})
# -------- الرسوم البيانية --------
output$plot1 <- renderPlotly({
df <- filtered_data()
req(df)
validate(need(nrow(df) > 0, "لا توجد بيانات"))
plot_data <- df %>%
group_by(PROJET) %>%
summarise(TOTAL = sum(TOTAL_TTC, na.rm = TRUE))
plot_ly(plot_data,
labels = ~PROJET,
values = ~TOTAL,
type = "pie",
hole = 0.55,
marker = list(colors = c("#ff6b6b", "#4ecdc4", "#ffd93d")),
textinfo = "label+percent",
hoverinfo = "label+value+percent") %>%
layout(title = "Part des Dépenses",
paper_bgcolor = "#1a2332",
plot_bgcolor = "#1a2332",
font = list(color = "#f0f4f8"),
showlegend = TRUE)
})
output$plot2 <- renderPlotly({
df <- filtered_data()
req(df)
validate(need(nrow(df) > 0, "لا توجد بيانات"))
plot_data <- df %>%
group_by(FOURNISSEUR) %>%
summarise(TOTAL = sum(TOTAL_TTC, na.rm = TRUE)) %>%
arrange(desc(TOTAL)) %>%
head(10)
plot_ly(plot_data,
x = ~TOTAL,
y = ~reorder(FOURNISSEUR, TOTAL),
type = "bar",
orientation = "h",
marker = list(color = "#22d3ee")) %>%
layout(title = "Top 10 Fournisseurs",
