n_suppliers <- length(unique(df$FOURNISSEUR))
div(style = "background: #1a2332; padding: 20px; border-radius: 16px; border: 1px solid #2a3a52;",
h4(style = "color: #22d3ee;", "📊 ملخص التقرير"),
hr(),
