HTML(paste0("<div style='color: #8b9db8; font-size: 10px;'>TOTAL HT</div>",
"<div style='color: #f0f4f8; font-size: 18px; font-weight: 800;'>",
format(round(total_ht), big.mark = ","), " DZD</div>"))
),
div(style = "padding: 10px; background: #0f3460; border-radius: 10px; text-align: center;",
HTML(paste0("<div style='color: #8b9db8; font-size: 10px;'>TOTAL TTC</div>",
"<div style='color: #f0f4f8; font-size: 18px; font-weight: 800;'>",
format(round(total_ttc), big.mark = ","), " DZD</div>"))
),
div(style = "padding: 10px; background: #0f3460; border-radius: 10px; text-align: center;",
HTML(paste0("<div style='color: #8b9db8; font-size: 10px;'>LIGNES</div>",
"<div style='color: #f0f4f8; font-size: 18px; font-weight: 800;'>", n_items, "</div>"))
),
div(style = "padding: 10px; background: #0f3460; border-radius: 10px; text-align: center;",
HTML(paste0("<div style='color: #8b9db8; font-size: 10px;'>FOURNISSEURS</div>",
"<div style='color: #f0f4f8; font-size: 18px; font-weight: 800;'>", n_suppliers, "</div>"))
)
)
)
})
}
